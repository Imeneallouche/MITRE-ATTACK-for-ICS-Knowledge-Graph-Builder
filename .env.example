# MITRE ATT&CK for ICS Knowledge Graph — copy to .env and fill in values. Never commit .env.
#
# Neo4j (required for mitre_ics_matrix_v18_to_kg, mitre_ics_matrix_v17_to_kg, add_missing_relationships)
NEO4J_URI=neo4j+s://xxxx.databases.neo4j.io
NEO4J_USER=neo4j
# Or use the common alternate name (either NEO4J_USER or NEO4J_USERNAME is accepted):
# NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=your-neo4j-password

# v18 main graph build: clear database before import (true/false)
# MITRE_KG_CLEAR_EXISTING=true

# Optional: override default paths (relative to repo root or absolute)
# MITRE_ICS_V18_EXCEL=input/ics-attack-v18.0.xlsx
# MITRE_ICS_V17_EXCEL=input/ics-attack-v17.1.xlsx
# MITRE_ICS_V18_COMPLEMENTARY_EXCEL=input/ics-attack-v18.0-complementary.xlsx
#
# Preprocessing (no Neo4j): extract_datacomponents.py, ds_analytic_relation.py
# MITRE_DATACOMPONENT_SCRAPER_INPUT=input/ics-attack-v18.0.xlsx
# MITRE_DATACOMPONENT_SCRAPER_OUTPUT=analytics_with_datacomponents.xlsx
# MITRE_DS_ANALYTIC_MAP_INPUT=input/ics-attack-v18.0.xlsx
# MITRE_DS_ANALYTIC_MAP_OUTPUT=analytic_detectionstrategy_mapping.xlsx
